      ],
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import plotly\n",
        "import plotly.express as px\n",
        "\n",
        "# Generación de datos reproducibles\n",
        "rng = np.random.default_rng(42)\n",
        "df = pd.DataFrame({\n",
        "    \"channel\": [\"Online\"] * 100 + [\"Store\"] * 100,\n",
        "    \"amount\": np.round(rng.lognormal(3.5, 0.6, 200), 2),\n",
        "})\n",
        "\n",
        "# Inyección controlada de 1 valor faltante\n",
        "df.loc[0, \"amount\"] = np.nan\n",
        "\n",
        "print(\"Versions:\", np.__version__, pd.__version__, plotly.__version__)\n",
        "print(\"Total raw rows:\", len(df))\n",
        "print(\"Missing values:\\n\", df[[\"amount\", \"channel\"]].isna().sum())\n",
        "\n",
        "# Limpieza de datos\n",
        "clean = df.dropna(subset=[\"amount\", \"channel\"]).copy()\n",
        "\n",
        "if len(clean) < 2 or not np.isfinite(clean[\"amount\"]).all():\n",
        "    raise ValueError(\"Need at least two finite amounts\")\n",
        "\n",
        "print(\"\\nAnalyzed rows:\", len(clean))\n",
        "print(\"\\nDescriptive Statistics (Overall):\")\n",
        "print(clean[\"amount\"].describe().round(2))\n",
        "print(\"Median:\", round(clean[\"amount\"].median(), 2))\n",
        "\n",
        "print(\"\\nGrouped by Channel:\")\n",
        "print(clean.groupby(\"channel\")[\"amount\"].agg(\n",
        "    [\"count\", \"mean\", \"median\", \"std\", \"min\", \"max\"]\n",
        ").round(2))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "histogram = px.histogram(\n",
        "    clean,\n",
        "    x=\"amount\",\n",
        "    nbins=20,\n",
        "    title=\"Transaction amount distribution\",\n",
        "    labels={\"amount\": \"Amount (synthetic units)\"}\n",
        ")\n",
        "\n",
        "box = px.box(\n",
        "    clean,\n",
        "    x=\"channel\",\n",
        "    y=\"amount\",\n",
        "    title=\"Amounts by channel\",\n",
        "    labels={\"amount\": \"Amount (synthetic units)\", \"channel\": \"Channel\"}\n",
        ")\n",
        "\n",
        "histogram.show()\n",
        "box.show()"
      ],
